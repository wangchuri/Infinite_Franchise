# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS — frontend origin
CORS_ORIGIN=http://localhost:3000

# Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/infinite_franchise

# Auth (local mock — change in production)
JWT_SECRET=dev-change-me-to-a-long-random-string

# File storage (local folder now; switch via STORAGE_DRIVER later)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
PUBLIC_FILE_BASE_URL=http://localhost:4000/files
