{
  "name": "infinite-franchise-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Infinite Franchise API (Node + TypeScript)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:ensure": "tsx scripts/ensure-db.mts",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed-mock-users.mts",
    "db:seed:works": "tsx scripts/seed-mock-works.mts",
    "db:seed:reading": "tsx scripts/seed-reading-demo.mts",
    "db:seed:shenhui": "tsx scripts/seed-shenhui.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^9.3.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "jose": "^6.2.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
